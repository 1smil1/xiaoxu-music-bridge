{
  "manifest_version": 3,
  "key": "",
  "name": "xiaoxu-music-bridge",
  "version": "3.5.0",
  "description": "启动并守护 xiaoxu-music-host，本地媒体数据由网页直接连接 Host",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://xiaoxu.xin/*",
    "http://localhost:17888/*",
    "http://127.0.0.1:17888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://xiaoxu.xin/*"
      ],
      "js": ["reconnect-policy.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
