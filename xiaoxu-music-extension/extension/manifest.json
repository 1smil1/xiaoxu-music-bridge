{
  "manifest_version": 3,
  "key": "",
  "name": "xiaoxu-music-bridge",
  "version": "3.2.5",
  "description": "桥接本地音乐播放器到 xiaoxu.xin 壁纸页面，含多频带音频律动分析与 12 事件律动调色板",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://xiaoxu.xin/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://xiaoxu.xin/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "*://xiaoxu.xin/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
